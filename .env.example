# ==========================================================
# VENTURE INTELLIGENCE ROOT CONFIGURATION TEMPLATE
# ==========================================================

# --- [API Credentials] ---
# Required for running live GitHub crawlers and scans (can be a standard personal access token)
GITHUB_TOKEN=your_github_token_here

# Required for executing the multi-agent screening, diligence, and memo LLM calls
OPENAI_API_KEY=your_openai_api_key_here

# --- [Database Configuration] ---
# Optional. Overrides the default SQLite database path.
# FIRSTCHECK_DATABASE_URL=sqlite:///backend/firstcheck.db

# --- [Frontend Proxy Config] ---
# Tells the TanStack Start frontend server where your FastAPI backend resides.
# Local FastAPI default: http://localhost:8000
# Live GCP Cloud Run backend: https://venture-intelligence-backend-53330586668.us-east5.run.app
FIRSTCHECK_BACKEND_URL=http://localhost:8000
